<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootBox" fillWidth="true" maxHeight="Infinity" maxWidth="Infinity" spacing="15" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.MCcontroller">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <children>

        <!-- QUESTION -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <children>

                <Label minWidth="120" text="Enter Question:" />

                <TextField fx:id="question" maxWidth="Infinity" promptText="Type your question here..." HBox.hgrow="ALWAYS" />

            </children>
        </HBox>

        <!-- OPTION 1 -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <children>

                <Label minWidth="120" text="Option 1:" />

                <TextField fx:id="option1" maxWidth="Infinity" HBox.hgrow="ALWAYS" />

                <RadioButton fx:id="correctA" text="Correct Answer">
                    <toggleGroup>
                        <ToggleGroup fx:id="GroupA" />
                    </toggleGroup>
                </RadioButton>

            </children>
        </HBox>

        <!-- OPTION 2 -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <children>

                <Label minWidth="120" text="Option 2:" />

                <TextField fx:id="option2" maxWidth="Infinity" HBox.hgrow="ALWAYS" />

                <RadioButton fx:id="correctB" text="Correct Answer" toggleGroup="$GroupA" />

            </children>
        </HBox>

        <!-- OPTION 3 -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <children>

                <Label minWidth="120" text="Option 3:" />

                <TextField fx:id="option3" maxWidth="Infinity" HBox.hgrow="ALWAYS" />

                <RadioButton fx:id="correctC" text="Correct Answer" toggleGroup="$GroupA" />

            </children>
        </HBox>

        <!-- OPTION 4 -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <children>

                <Label minWidth="120" text="Option 4:" />

                <TextField fx:id="option4" maxWidth="Infinity" HBox.hgrow="ALWAYS" />

                <RadioButton fx:id="correctD" text="Correct Answer" toggleGroup="$GroupA" />

            </children>
        </HBox>

        <!-- BUTTONS -->
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <children>
            <Label fx:id="errors" />

                <Button onAction="#add" prefWidth="100" text="Add" />

            </children>
        </HBox>

    </children>

</VBox>
