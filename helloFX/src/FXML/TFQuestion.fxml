<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootBox" fillWidth="true" maxHeight="Infinity" maxWidth="Infinity" spacing="20" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.TFController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <children>

        <!-- QUESTION -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <children>

                <Label minWidth="140" text="Enter Question:" />

                <TextField fx:id="question" maxWidth="Infinity" promptText="Type your true/false question..." HBox.hgrow="ALWAYS" />

            </children>
        </HBox>

        <!-- ANSWER LABEL -->
        <HBox alignment="CENTER_LEFT">
            <children>

                <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Correct Answer:" />

            </children>
        </HBox>

        <!-- TRUE -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <children>

                <RadioButton fx:id="trueA" text="True">
                    <toggleGroup>
                        <ToggleGroup fx:id="Group" />
                    </toggleGroup>
                </RadioButton>

            </children>
        </HBox>

        <!-- FALSE -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <children>

                <RadioButton fx:id="falseA" text="False" toggleGroup="$Group" />

            </children>
        </HBox>

        <!-- SPACER -->
        <VBox VBox.vgrow="ALWAYS" />

        <!-- BUTTONS -->
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <children>

                <Button onAction="#back" prefWidth="100" text="Delete" />

            </children>
        </HBox>

    </children>

</VBox>
