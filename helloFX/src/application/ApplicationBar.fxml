<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.ApplicationBarController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color:#f4f4f4;                      -fx-border-color:lightgray;                      -fx-border-width:0 0 1 0;">

            <padding>
                <Insets bottom="4" left="10" right="10" top="4" />
            </padding>

            <children>

<VBox fx:id="logo" alignment="CENTER" maxHeight="24" maxWidth="24" prefHeight="24" prefWidth="24" />

                <Label style="-fx-font-size:15px;                               -fx-font-weight:bold;" text="Clearmind" />

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER_RIGHT" spacing="6">
                    <children>
                        <Button onAction="#home" text="Home" />
                        <Button onAction="#quizzesAndFlashcards" text="Quizzes" />
                        <Button onAction="#dungeonEscapeGame" text="Dungeon" />
                        <Button onAction="#callender" text="Calendar" />
                        <Button onAction="#usageTimer" text="Timer" />
                        <Button onAction="#notes" text="Notes" />
                    </children>
                </HBox>

            </children>
        </HBox>
    </top>

    <center>
        <VBox fx:id="editorPane" />
    </center>

</BorderPane>
