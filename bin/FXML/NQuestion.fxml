<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootBox" fillWidth="true" maxHeight="Infinity" maxWidth="Infinity" spacing="15" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.NController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <children>

        <!-- QUESTION -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <children>

                <Label minWidth="160" text="Enter Question:" />

                <TextField fx:id="question" maxWidth="Infinity" promptText="Type your question here..." HBox.hgrow="ALWAYS" />

            </children>
        </HBox>

        <!-- NUMBER ANSWER -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <children>

                <Label minWidth="160" text="Enter Number Answer:" />

                <TextField fx:id="answer" maxWidth="Infinity" promptText="Correct numerical answer..." HBox.hgrow="ALWAYS" />

            </children>
        </HBox>

        <!-- SPACER -->
        <VBox VBox.vgrow="ALWAYS" />

        <!-- BUTTONS -->
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <children>

                <Button onAction="#back" prefWidth="100" text="Delete" />

            </children>
        </HBox>

    </children>

</VBox>
